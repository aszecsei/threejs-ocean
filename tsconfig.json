{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    // noUncheckedIndexedAccess is deliberately OFF. This is numeric graphics
    // code: gradient tables, Halton sequences, butterfly tables and typed
    // arrays are indexed in tight loops with in-range indices by construction.
    // Enabling it produced ~145 errors whose only fix is a non-null assertion,
    // which buys no safety and costs readability.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "test", "vite.config.ts"]
}
